msgstr "字符串：`'float32'`"

#: ../../../programming_guides/instructions.md:258
msgid "TileLang dtype: `T.float32`"
msgstr "TileLang 数据类型：`T.float32`"

#: ../../../programming_guides/instructions.md:259
