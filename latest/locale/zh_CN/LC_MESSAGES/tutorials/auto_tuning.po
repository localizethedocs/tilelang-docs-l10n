#: ../../../tutorials/auto_tuning.md:19
msgid "Step 1: Implement with Reserved Parameters"
msgstr "步骤 1：使用预留参数实现"

#: ../../../tutorials/auto_tuning.md:20
msgid ""
"Users can implement matrix multiplication in Tile Language while reserving "
"parameters for optimization:"
msgstr "用户可以使用 Tile Language 实现矩阵乘法，同时为优化预留参数："

#: ../../../tutorials/auto_tuning.md:21
msgid ""
"# Reserved parameters for optimization\n"
"def kernel(\n"
"    block_M=None,\n"
"    block_N=None,\n"
"    block_K=None,\n"
"    num_stages=None,\n"
"    thread_num=None,\n"
"    enable_rasteration=None,\n"
"):\n"
"    dtype = \"float16\"\n"
"    accum_dtype = \"float\"\n"
"\n"
"    # Matrix multiplication implementation\n"
"    @T.prim_func\n"
"    def main(\n"
"            A: T.Buffer((M, K), dtype),\n"
"            B: T.Buffer((N, K), dtype),\n"
"            C: T.Buffer((M, N), dtype),\n"
"    ):\n"
"        # ...existing code...\n"
"\n"
"    return main\n"
msgstr ""
"# Reserved parameters for optimization\n"
"def kernel(\n"
"    block_M=None,\n"
"    block_N=None,\n"
"    block_K=None,\n"
"    num_stages=None,\n"
"    thread_num=None,\n"
"    enable_rasteration=None,\n"
"):\n"
"    dtype = \"float16\"\n"
"    accum_dtype = \"float\"\n"
"\n"
"    # Matrix multiplication implementation\n"
"    @T.prim_func\n"
"    def main(\n"
"            A: T.Buffer((M, K), dtype),\n"
"            B: T.Buffer((N, K), dtype),\n"
"            C: T.Buffer((M, N), dtype),\n"
"    ):\n"
"        # ...existing code...\n"
"\n"
"    return main\n"

