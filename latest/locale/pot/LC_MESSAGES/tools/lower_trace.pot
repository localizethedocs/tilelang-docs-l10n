"            │   ├── 01_Simplify_before.tir\n"
"            │   └── 01_Simplify_after.tir\n"
"            ├── phase2_optimize/        # another phase (illustrative)\n"
"            │   └── ...\n"
"            ├── codegen/\n"
"            │   ├── 42_codegen_before.tir\n"
"            │   └── 42_codegen_after.cpp\n"
