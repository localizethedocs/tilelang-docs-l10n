msgid ""
"When HTML output is enabled, a stable symlink `<script_dir>/report.html` is "
"maintained and points to the latest run's report. Open it directly in a "
"browser:"
msgstr ""

#: ../../../tools/lower_trace.md:59
msgid ""
"# typical location\n"
"open tmp/lower_trace_dir/my_script/report.html\n"
msgstr ""

