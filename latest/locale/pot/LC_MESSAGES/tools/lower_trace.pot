"        (\"Split\",      tvm.tirx.transform.SplitHostDevice()),\n"
"        (\"ThreadSync\", transform.ThreadSync(\"shared\")),\n"
"    ],\n"
"    mode=\"both\",\n"
"    html_path=\"my_diff.html\",\n"
