"Disable shared memory reuse planning in MergeSharedMemoryAllocations. When "
"enabled, shared memory allocations are still merged into a single allocation "
"but each buffer gets its own dedicated region without lifetime-based reuse. "
"Default: False"
msgstr ""

#: ../../../autoapi/tilelang/transform/pass_config/index.rst:446
msgid "Disable shuffle election optimization. Default"
msgstr ""

#: ../../../autoapi/tilelang/transform/pass_config/index.rst:455
msgid "Disable loop unswitching optimization. Default"
msgstr ""

#: ../../../autoapi/tilelang/transform/pass_config/index.rst:462
