#: ../../../autoapi/tilelang/contrib/cutedsl/grid_sync/index.rst:2
msgid "tilelang.contrib.cutedsl.grid_sync"
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/grid_sync/index.rst:8
msgid "Grid-level synchronization for CuTeDSL backend."
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/grid_sync/index.rst:10
msgid ""
"Implements the grid barrier of CUDA cooperative groups "
"(``this_grid().sync()``) on the per-launch grid workspace that the driver "
"provides to cooperative launches (cuLaunchCooperativeKernel). Its address is "
"read from the ``%envreg1`` (high half) and ``%envreg2`` (low half) special "
"registers, as in ``cooperative_groups::details::get_grid_workspace``, so "
"concurrent launches of the same kernel never share barrier state."
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/grid_sync/index.rst:17
msgid ""
"The barrier: 1. __syncthreads() within each block 2. Thread 0 of each block "
"adds its arrival to the workspace barrier word with"
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/grid_sync/index.rst:20
msgid ""
"release semantics; block 0 adds the value that flips bit 31 once all blocks "
"have arrived"
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/grid_sync/index.rst:22
msgid "Thread 0 spins with acquire loads until bit 31 differs from its arrival"
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/grid_sync/index.rst:23
msgid "__syncthreads() releases the rest of the block"
msgstr ""

