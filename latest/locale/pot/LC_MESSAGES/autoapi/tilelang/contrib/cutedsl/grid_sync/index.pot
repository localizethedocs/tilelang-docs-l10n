msgid "Module Contents"
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/grid_sync/index.rst:42
msgid ""
"NOTE: This requires the kernel to be launched with "
"cuLaunchCooperativeKernel, which guarantees all thread blocks are resident "
"simultaneously and provides the grid workspace. The CuTeDSL wrapper handles "
"this automatically when the kernel uses sync_grid()."
msgstr ""
