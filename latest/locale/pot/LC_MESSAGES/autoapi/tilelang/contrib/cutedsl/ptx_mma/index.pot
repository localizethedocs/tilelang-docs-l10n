#: ../../../autoapi/tilelang/contrib/cutedsl/ptx_mma/index.rst:2
msgid "tilelang.contrib.cutedsl.ptx_mma"
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/ptx_mma/index.rst:8
msgid ""
"PTX MMA operations for CuTeDSL backend. Based on tl_templates/cuda/"
"instruction/mma.h"
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/ptx_mma/index.rst:11
msgid ""
"These functions provide wrappers around PTX mma.sync instructions for "
"performing matrix multiply-accumulate operations using Tensor Cores."
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/ptx_mma/index.rst:14
msgid "Uses inline PTX assembly for direct MMA instruction generation."
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/ptx_mma/index.rst:16
msgid ""
"Supported dense configurations (from mma.h): - FP16: m16n8k16 -> f16/f32 "
"accumulator - BF16: m16n8k16 -> f32 accumulator - INT8: m16n8k32 -> i32 "
"accumulator - UINT8: m16n8k32 -> i32 accumulator - INT4: m16n8k32 -> i32 "
"accumulator (mapped to m16n8k64 in PTX) - UINT4: m16n8k32 -> i32 accumulator "
"- FP8 (e4m3/e5m2): m16n8k32 -> f16/f32 accumulator - TF32: m16n8k4, m16n8k8 "
"-> f32 accumulator - FP64: m8n8k4 -> f64 accumulator"
msgstr ""

#: ../../../autoapi/tilelang/contrib/cutedsl/ptx_mma/index.rst:27
msgid ""
"Sparse variants mirror the dense ones with halved A registers, an extra "
"metadata register, and a sparse_selector literal. Like ``tl_templates/cuda/"
"instruction/mma_sp.h`` they cover f16/bf16/tf32, s8/u8 and FP8 (e4m3/e5m2, "
"sm_89+), and emit ``mma.sp::ordered_metadata``, which PTX recommends over "
"plain ``mma.sp`` for performance."
msgstr ""

