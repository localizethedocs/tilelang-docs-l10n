#: ../../../autoapi/tilelang/contrib/ptodsl/allreduce/index.rst:8
msgid "SIMT cross-workitem all-reduce."
msgstr ""

#: ../../../autoapi/tilelang/contrib/ptodsl/allreduce/index.rst:10
msgid ""
"Vendored from the PTOAS project (``ptodsl/ptodsl/_allreduce.py``); upstream "
"commit f5eff3ee249697f6157088f649c6434fcc9d7c5b (\"refactor(ptodsl): remove "
"the SIMT allreduce helpers\") removed the module expecting TileLang to own "
"the implementation. contrib.ptodsl's integer-signedness compatibility, "
"previously applied as monkey patches from ``simt.py``, is merged directly "
"into the reducer tables and the dtype dispatch."
msgstr ""

#: ../../../autoapi/tilelang/contrib/ptodsl/allreduce/index.rst:17
msgid ""
"All-reduce ops are emitted **inline** at the current insertion point. Three "
"reducer variants: ``simt_allreduce_sum``, ``simt_allreduce_max``, "
"``simt_allreduce_min``."
msgstr ""

#: ../../../autoapi/tilelang/contrib/ptodsl/allreduce/index.rst:20
msgid ""
"Dispatch tree (compile-time, since *threads* / *scale* are Python ints)::"
msgstr ""

#: ../../../autoapi/tilelang/contrib/ptodsl/allreduce/index.rst:22
msgid ""
"threads <= scale                                       →  identity\n"
"threads ≤ 32,  pow2(threads), pow2(scale)              →  warp_reduce\n"
"threads ≤ 32                                           →  ub_reduce\n"
"threads > 32,  pow2(threads), scale≤32, pow2(scale)   →  cross_warp_reduce\n"
"otherwise                                              →  ub_reduce "
"(fallback)"
msgstr ""

