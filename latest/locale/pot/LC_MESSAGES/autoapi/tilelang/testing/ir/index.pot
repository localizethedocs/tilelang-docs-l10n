#: ../../../autoapi/tilelang/testing/ir/index.rst:8
msgid "Small, exact queries for compiler tests, without running any passes."
msgstr ""

#: ../../../autoapi/tilelang/testing/ir/index.rst:10
msgid ""
"Counts describe unique static IR nodes within each visited function, "
"following TVM's post-order visitor. They do not describe dynamic execution "
"counts or order. Call queries automatically reuse an index of the most "
"recently queried body."
msgstr ""

#: ../../../autoapi/tilelang/testing/ir/index.rst:17
msgid "Functions"
msgstr ""

