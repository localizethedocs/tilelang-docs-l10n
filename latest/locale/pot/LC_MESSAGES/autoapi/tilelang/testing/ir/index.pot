msgid ""
":py:obj:`collect_nodes <tilelang.testing.ir.collect_nodes>`\\ \\(root\\, "
"node\\_type\\, \\*\\[\\, function\\]\\)"
msgstr ""

#: ../../../autoapi/tilelang/testing/ir/index.rst:32
#: ../../../autoapi/tilelang/testing/ir/index.rst:26:<autosummary>:1
