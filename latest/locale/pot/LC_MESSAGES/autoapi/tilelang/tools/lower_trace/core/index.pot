msgid "tilelang.tools.lower_trace.core"
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/core/index.rst:8
msgid "IR lower tracing implemented as a per-compilation instrumentation tool."
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/core/index.rst:10
msgid ""
"``enable()`` only registers configuration for future compilations.  Every "
"compiler front door snapshots that configuration into a distinct "
"``LowerTraceSession`` which owns its records, pass numbering, pipeline "
"scopes, and report lifecycle.  No TVM global function or default "
"``PassContext`` is patched."
msgstr ""

