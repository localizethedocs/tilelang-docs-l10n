msgid "tilelang.tools.compile_only"
msgstr ""

#: ../../../autoapi/tilelang/tools/compile_only/index.rst:8
msgid ""
"Compile-only tool: emit inspectable ``lower()`` kernel source without a GPU."
msgstr ""

#: ../../../autoapi/tilelang/tools/compile_only/index.rst:10
msgid "Usage::"
msgstr ""

#: ../../../autoapi/tilelang/tools/compile_only/index.rst:12
msgid ""
"python3 -I -m tilelang.tools.compile_only --output_file out.s example.py"
msgstr ""

#: ../../../autoapi/tilelang/tools/compile_only/index.rst:14
msgid "The default target is ``c`` (CPU C). CUDA is optional::"
msgstr ""

#: ../../../autoapi/tilelang/tools/compile_only/index.rst:16
msgid ""
"python3 -I -m tilelang.tools.compile_only --target cuda --output_file out.s "
"example.py"
msgstr ""

#: ../../../autoapi/tilelang/tools/compile_only/index.rst:18
msgid "Programmatic API::"
msgstr ""

#: ../../../autoapi/tilelang/tools/compile_only/index.rst:20
msgid ""
