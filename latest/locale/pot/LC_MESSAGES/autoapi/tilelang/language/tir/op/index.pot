#: ../../../autoapi/tilelang/language/tir/op/index.rst:2280
msgid "Example"
msgstr ""

#: ../../../autoapi/tilelang/language/tir/op/index.rst:2281
msgid ""
"n = te.var(\"n\")\n"
"m = te.var(\"m\")\n"
"mysum = te.comm_reducer(lambda x, y: x+y,\n"
"    lambda t: tvm.tir.const(0, dtype=t), name=\"mysum\")\n"
"A = te.placeholder((n, m), name=\"A\")\n"
"k = te.reduce_axis((0, m), name=\"k\")\n"
"B = te.compute((n,), lambda i: mysum(A[i, k], axis=k), name=\"B\")"
msgstr ""

