#: ../../../autoapi/tilelang/language/atomic/index.rst:34
msgid ""
"Supports scalar/addressed extern atomic max when neither argument exposes "
"extents, or tile-region-based atomic max for Buffer/BufferRegion/BufferLoad "
"inputs. If both arguments are plain Buffers their shapes must be "
"structurally equal. If at least one side exposes extents, extents are "
"aligned (missing dimensions are treated as size 1); an assertion is raised "
"if extents cannot be deduced. The optional `memory_order` (one of "
"\"relaxed\",\"consume\",\"acquire\",\"release\",\"acq_rel\",\"seq_cst\") is "
"honored on CUDA targets by both the direct extern `AtomicMax` path and the "
"tile-region path. HIP and CuteDSL codegen currently ignore it."
msgstr ""

#: ../../../autoapi/tilelang/language/atomic/index.rst:0
msgid "Parameters"
msgstr ""

#: ../../../autoapi/tilelang/language/atomic/index.rst:36
msgid "Destination buffer/address to apply the atomic max."
msgstr ""

#: ../../../autoapi/tilelang/language/atomic/index.rst:38
#: ../../../autoapi/tilelang/language/atomic/index.rst:85
msgid "Value to compare/store atomically."
msgstr ""

#: ../../../autoapi/tilelang/language/atomic/index.rst:40
msgid ""
"Optional memory-order name (e.g. \"relaxed\", \"acquire\", \"seq_cst\"). If "
"provided, it is translated to the corresponding numeric memory-order id "
"before the call."
msgstr ""

#: ../../../autoapi/tilelang/language/atomic/index.rst:43
