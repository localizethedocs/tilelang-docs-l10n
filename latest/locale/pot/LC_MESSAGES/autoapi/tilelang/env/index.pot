#: ../../../autoapi/tilelang/env/index.rst:154
msgid "Purpose"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:155
msgid ""
"In many projects, access to environment variables is scattered across the "
"codebase:"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:156
msgid "`os.environ.get(...)` calls are repeated everywhere"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:157
msgid "Default values are hard-coded in multiple places"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:158
msgid "Overriding env vars for tests/debugging is messy"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:159
msgid ""
"There's no central place to see all environment variables a package uses"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:161
msgid "This descriptor solves those issues by:"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:162
msgid ""
"Centralizing the definition of the variable's **key** and **default value**"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:163
msgid ""
"Allowing *dynamic* reads from `os.environ` so changes take effect immediately"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:164
msgid ""
"Supporting **forced overrides** at runtime (for unit tests or debugging)"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:165
msgid ""
"Logging a warning when a forced value is used (helps detect unexpected "
"overrides)"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:166
msgid ""
"Optionally syncing forced values back to `os.environ` if global consistency "
"is desired"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:169
msgid "How it works"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:170
msgid ""
"This is a `dataclass` implementing the descriptor protocol (`__get__`, "
"`__set__`)"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:171
msgid "When used as a class attribute, `instance.attr` triggers `__get__()`"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:172
msgid ""
"→ returns either the forced override or the live value from `os.environ`"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:173
msgid ""
"Assigning to the attribute (`instance.attr = value`) triggers `__set__()`"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:174
msgid "→ stores `_forced_value` for future reads"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:175
msgid ""
"You may uncomment the `os.environ[...] = value` line in `__set__` if you "
"want the override to persist globally in the process"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:179
msgid "Example"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:180
msgid "```python class Environment:"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:182
msgid ""
"TILELANG_PRINT_ON_COMPILATION = EnvVar(\"TILELANG_PRINT_ON_COMPILATION\", "
"\"0\")"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:184
msgid ""
"env = Environment() print(cfg.TILELANG_PRINT_ON_COMPILATION)  # Reads from "
"os.environ (with default fallback) cfg.TILELANG_PRINT_ON_COMPILATION = "
"\"1\"   # Forces value to \"1\" until changed/reset ```"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:190
msgid "Benefits"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:191
msgid "Centralizes all env-var keys and defaults in one place"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:192
msgid "Live, up-to-date reads (no stale values after `import`)"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:193
msgid "Testing convenience (override without touching the real env)"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:194
msgid "Improves IDE discoverability and type hints"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:195
msgid "Avoids hardcoding `os.environ.get(...)` in multiple places"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:211
msgid ""
"Called when the attribute is accessed. 1. If a forced value is set, return "
"it and log a warning 2. Otherwise, look up the value in os.environ; return "
"the default if missing"
msgstr ""

#: ../../../autoapi/tilelang/env/index.rst:219
msgid ""
"Called when the attribute is assigned to. Stores the value as a runtime "
"override (forced value). Optionally, you can also sync this into os.environ "
"for global effect."
msgstr ""

