"\"\"\"\n"
"static std::atomic<unsigned long long> {0}_smem_devices{{0}};\n"
"\n"
"static int {0}_set_dynamic_smem() {{\n"
"    int device = 0;\n"
"    cudaError_t query = cudaGetDevice(&device);\n"
"    if (query != cudaSuccess) {{\n"
"        snprintf(error_buf, ERROR_BUF_SIZE, \"Failed to get the current "
"device: %s\", cudaGetErrorString(query));\n"
"        return -1;\n"
"    }}\n"
"    unsigned long long bit = device < 64 ? 1ull << device : 0;\n"
"    if (bit && ({0}_smem_devices.load(std::memory_order_relaxed) & bit)) {{\n"
"        return 0;\n"
"    }}\n"
"    cudaError_t result = cudaFuncSetAttribute({0}, "
"cudaFuncAttributeMaxDynamicSharedMemorySize, {1});\n"
"    if (result != cudaSuccess) {{\n"
"        snprintf(error_buf, ERROR_BUF_SIZE, \"Failed to set the allowed "
"dynamic shared memory size to %d with error: %s\", {1}, "
"cudaGetErrorString(result));\n"
"        return -1;\n"
"    }}\n"
"    {0}_smem_devices.fetch_or(bit, std::memory_order_relaxed);\n"
"    return 0;\n"
"}}\n"
"\"\"\""
msgstr ""

