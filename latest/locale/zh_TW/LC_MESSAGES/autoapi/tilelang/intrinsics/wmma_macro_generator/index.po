msgid "Only supports the f16->f32, 16x16x16 variant with warp-size=32."
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_macro_generator/index.rst:12
msgid "Thread-data mapping (per AMDGPU ISA):"
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_macro_generator/index.rst:13
msgid ""
"A[16][K=16]: thread t holds A[t//2][(t%2)*8 : (t%2)*8+8]  (8 fp16 = 4 f32 "
"per thread) B[K=16][16]: same mapping as A for the transposed dimension C/"
"D[16][16]: thread t holds D[t//2][(t%2)*8 : (t%2)*8+8]  (8 f32 per thread)"
msgstr ""

