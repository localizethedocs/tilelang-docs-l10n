#: ../../../autoapi/tilelang/cuda/op/gemm/gemm_wgmma/index.rst:39
msgid ""
"WGMMA can directly use shared memory as input, so the swizzle layout must "
"match the tensor core's access pattern. The swizzle granularity is "
"determined by the continuous dimension size:"
msgstr ""

#: ../../../autoapi/tilelang/cuda/op/gemm/gemm_wgmma/index.rst:42
msgid "128B swizzle (Full):    continuity % (vectorized_size * 8) == 0"
msgstr ""

#: ../../../autoapi/tilelang/cuda/op/gemm/gemm_wgmma/index.rst:43
msgid "64B swizzle (Half):     continuity % (vectorized_size * 4) == 0"
msgstr ""

#: ../../../autoapi/tilelang/cuda/op/gemm/gemm_wgmma/index.rst:44
msgid "32B swizzle (Quarter):  continuity % (vectorized_size * 2) == 0"
msgstr ""

