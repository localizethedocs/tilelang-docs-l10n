#: ../../../autoapi/tilelang/language/dtypes/index.rst:57
#: ../../../autoapi/tilelang/language/dtypes/index.rst:181
msgid ""
"A generic type is typically declared by inheriting from this class "
"parameterized with one or more type variables. For example, a generic "
"mapping type might be defined as::"
msgstr ""

#: ../../../autoapi/tilelang/language/dtypes/index.rst:61
#: ../../../autoapi/tilelang/language/dtypes/index.rst:185
msgid ""
"class Mapping(Generic[KT, VT]):\n"
"    def __getitem__(self, key: KT) -> VT:\n"
"        ...\n"
"    # Etc."
msgstr ""

#: ../../../autoapi/tilelang/language/dtypes/index.rst:66
#: ../../../autoapi/tilelang/language/dtypes/index.rst:190
msgid "This class can then be used as follows::"
msgstr ""

#: ../../../autoapi/tilelang/language/dtypes/index.rst:68
#: ../../../autoapi/tilelang/language/dtypes/index.rst:192
msgid ""
"def lookup_name(mapping: Mapping[KT, VT], key: KT, default: VT) -> VT:\n"
"    try:\n"
"        return mapping[key]\n"
"    except KeyError:\n"
"        return default"
msgstr ""

