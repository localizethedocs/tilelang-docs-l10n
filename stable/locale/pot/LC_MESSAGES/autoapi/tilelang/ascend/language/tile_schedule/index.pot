msgid ""
"If True (default) allocate state and enable ``init`` / ``valid`` / "
"``next_block``. If False expose only the store-free ``coord`` decode."
msgstr ""

#: ../../../autoapi/tilelang/ascend/language/tile_schedule/index.rst:88
msgid ""
"Optional state-buffer name prefix. The default ``None`` uses generic auto-"
"generated names."
msgstr ""

