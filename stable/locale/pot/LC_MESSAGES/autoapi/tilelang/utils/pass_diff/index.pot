#: ../../../autoapi/tilelang/utils/pass_diff/index.rst:2
msgid "tilelang.utils.pass_diff"
msgstr ""

#: ../../../autoapi/tilelang/utils/pass_diff/index.rst:8
msgid "IR pass diff tool — compare TIR before/after each pass in a chain."
msgstr ""

#: ../../../autoapi/tilelang/utils/pass_diff/index.rst:11
msgid "Usage"
msgstr ""

#: ../../../autoapi/tilelang/utils/pass_diff/index.rst:14
msgid ""
"from tilelang.utils.pass_diff import pass_diff\n"
"\n"
"# Single pass, terminal colored diff\n"
"pass_diff(func, tilelang.transform.ThreadSync(\"shared\"))\n"
"\n"
"# Pass chain with named steps\n"
"pass_diff(func, [\n"
"    (\"AnnotateDeviceRegions\", tvm.tirx.transform."
"AnnotateDeviceRegions()),\n"
"    (\"SplitHostDevice\",       tvm.tirx.transform.SplitHostDevice()),\n"
"    (\"ThreadSync\",            tilelang.transform.ThreadSync(\"shared\")),\n"
"])\n"
"\n"
"# Generate HTML report\n"
"pass_diff(func, passes, mode=\"html\")\n"
"\n"
"# Both terminal + HTML\n"
"pass_diff(func, passes, mode=\"both\")"
msgstr ""

