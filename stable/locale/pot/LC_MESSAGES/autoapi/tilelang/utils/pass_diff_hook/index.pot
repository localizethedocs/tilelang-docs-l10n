#: ../../../autoapi/tilelang/utils/pass_diff_hook/index.rst:2
msgid "tilelang.utils.pass_diff_hook"
msgstr ""

#: ../../../autoapi/tilelang/utils/pass_diff_hook/index.rst:8
msgid "Framework-level pass diff hook."
msgstr ""

#: ../../../autoapi/tilelang/utils/pass_diff_hook/index.rst:10
msgid ""
"When the ``TILELANG_PASS_DIFF`` environment variable is enabled, this module "
"monkey-patches ``tvm.ir.transform.Pass.__call__`` to automatically capture "
"IR before/after every pass and generate diff reports."
msgstr ""

#: ../../../autoapi/tilelang/utils/pass_diff_hook/index.rst:14
msgid "Usage (no code changes needed)::"
msgstr ""

#: ../../../autoapi/tilelang/utils/pass_diff_hook/index.rst:16
msgid ""
"TILELANG_PASS_DIFF=terminal python3 my_script.py   # colored terminal diff\n"
"TILELANG_PASS_DIFF=html python3 my_script.py       # HTML report\n"
"TILELANG_PASS_DIFF=both python3 my_script.py       # both\n"
"python3 my_script.py                               # off (zero overhead)"
msgstr ""

