#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:2
msgid "tilelang.transform.decouple_type_cast"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:8
msgid "Decouple type cast vectorization constraints."
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:10
msgid ""
"When a vectorized loop has mixed-precision operations between local and "
"memory buffers, the vectorization length would be constrained by the GCD of "
"all involved dtypes."
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:14
msgid ""
"This pass decouples the constraints by inserting a local buffer as an "
"intermediate stage, allowing optimal vectorization for both computation and "
"memory access."
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:18
msgid ""
"Mixed-precision is detected by the presence of Cast nodes in the loop body."
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:20
msgid "Two cases are handled:"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:23
msgid "Case 1: local → memory (store to memory with mixed types)"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:24
#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:36
msgid "Before:"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:25
#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:29
#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:37
#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:43
msgid "for vec in T.vectorized(16):"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:26
msgid "b[vec] = T.cast(a_frag[vec], \"float4_e2m1fn\")"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:28
#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:40
msgid "After:"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:30
msgid "cast_buf[vec] = T.cast(a_frag[vec], \"float4_e2m1fn\")  # compute"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:31
#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:41
msgid "for vec_copy in T.vectorized(16):"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:32
msgid "b[vec_copy] = cast_buf[vec_copy]                      # copy to memory"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:35
msgid "Case 2: memory → local (load from memory with different dtype)"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:38
msgid "a_frag[vec] = T.cast(b[vec], \"float32\")"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:42
msgid ""
"cast_buf[vec_copy] = b[vec_copy]                      # copy from memory"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:44
msgid "a_frag[vec] = T.cast(cast_buf[vec], \"float32\")        # compute"
msgstr ""

#: ../../../autoapi/tilelang/transform/decouple_type_cast/index.rst:46
msgid ""
"The staging cast buffers together with the transformed loops are wrapped in "
"an opaque block annotated with `lexical_alloc_scope`, so their allocations "
"stay lexically scoped to the use site (see LowerOpaqueBlock / "
"StorageRewrite) instead of being hoisted to the kernel entry."
msgstr ""

