#: ../../../compiler_internals/metal_tilelang_development.md:602
msgid ""
"To reproduce the fp16-output MSL snippet in Section 1.4 from the repository "
"root (codegen-only, no Metal runtime required):"
msgstr ""

#: ../../../compiler_internals/metal_tilelang_development.md:605
msgid ""
"TILELANG_DISABLE_CACHE=1 python - <<'PY'\n"
"import tilelang\n"
"import tilelang.language as T\n"
"from tilelang import tvm\n"
"from testing.python.metal.test_metal_gemm_v2_linux import "
"matmul_gemm_v2_global_c\n"
"\n"
"func = matmul_gemm_v2_global_c(\n"
"    128, 256, 128, 64, 128,\n"
"    dtype=T.float16,\n"
"    accum_dtype=T.float16,\n"
"    threads=128,\n"
")\n"
"\n"
"metal4_target = tvm.target.Target({\"kind\": \"metal\", \"keys\": "
"[\"metal\", \"gpu\", \"metal4\"]})\n"
"with tvm.transform.PassContext(), metal4_target:\n"
"    print(tilelang.lower(func, target=metal4_target).kernel_source)\n"
"PY\n"
msgstr ""

#: ../../../compiler_internals/metal_tilelang_development.md:625
msgid ""
"The important detail is the output buffer dtype: `C` is `T.float16`, so the "
"generated source uses `device half* C` and emits the fp32-to-fp16 store cast "
"shown in Section 1.4."
msgstr ""

