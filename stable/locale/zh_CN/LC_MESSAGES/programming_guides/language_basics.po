"T.print(C_f, msg='accumulator:')\n"
"T.print(A_s, msg='A tile:')\n"
"T.print(C[0], msg='C[0] = ')\n"
msgstr ""
"T.print(C_f, msg='accumulator:')\n"
"T.print(A_s, msg='A tile:')\n"
"T.print(C[0], msg='C[0] = ')\n"

