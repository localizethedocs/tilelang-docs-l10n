msgstr ""

#: ../../../autoapi/tilelang/language/dtypes/index.rst:60
#: ../../../autoapi/tilelang/language/dtypes/index.rst:122
msgid ""
"def lookup_name(mapping: Mapping[KT, VT], key: KT, default: VT) -> VT:\n"
"    try:\n"
"        return mapping[key]\n"
"    except KeyError:\n"
"        return default"
msgstr ""

