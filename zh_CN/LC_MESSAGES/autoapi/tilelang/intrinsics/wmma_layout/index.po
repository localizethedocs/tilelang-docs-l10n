#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:8
msgid "Layout functions for AMD RDNA WMMA instructions (gfx11/gfx12)."
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:10
msgid ""
"EMPIRICALLY VERIFIED hardware layouts for wmma_f32_16x16x16_f16_w32_gfx12:"
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:12
msgid "A[M=16][K=16]:"
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:13
msgid ""
"thread t, elem e -> A[M=t%16][K=(t//16)*8+e] Forward: (M, K) -> "
"(thread=(K//8)*16+M, local=K%8) Reverse: (thread, local) -> (M=thread%16, "
"K=(thread//16)*8+local) Memory load: A[M=t%16][K=(t//16)*8..+7] -> "
"CONTIGUOUS in K (vectorized)"
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:18
msgid "B[K=16][N=16] (non-transposed, K x N storage):"
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:19
msgid ""
"thread t, elem e -> B[K=(t//16)*8+e][N=t%16] Forward: (K, N) -> "
"(thread=(K//8)*16+N, local=K%8) Reverse: (thread, local) -> "
"(K=(thread//16)*8+local, N=thread%16)"
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:23
msgid "B_T[N=16][K=16] (transposed storage of B):"
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:24
msgid "B_T[N=t%16][K=(t//16)*8+e] -> CONTIGUOUS in K (vectorized)"
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:26
msgid "D[M=16][N=16]:"
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:27
msgid ""
"thread t, elem l -> D[M=(t//16)*8+l][N=t%16] Forward: (M, N) -> "
"(thread=(M//8)*16+N, local=M%8) Reverse: (thread, local) -> "
"(M=(thread//16)*8+local, N=thread%16) Store: D[M=(t//16)*8+l][N=t%16] = "
"d_vec[l]"
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:32
msgid ""
"NOTE: A and D have DIFFERENT layouts (A uses t%16 for M, D uses (t//16)*8+l "
"for M). This means they cannot be used interchangeably without a layout "
"change."
msgstr ""

#: ../../../autoapi/tilelang/intrinsics/wmma_layout/index.rst:35
msgid "local_size = 8 per thread"
msgstr ""

