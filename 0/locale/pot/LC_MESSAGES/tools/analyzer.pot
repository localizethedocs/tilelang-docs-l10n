#: ../../../tools/analyzer.md:1
msgid "Performance Analyzer"
msgstr ""

#: ../../../tools/analyzer.md:3
msgid ""
"`tilelang.tools.Analyzer` inspects TileLang TIR and estimates its floating-"
"point work, global-memory traffic, and roofline execution time. It is useful "
"for checking a kernel's expected arithmetic cost before compiling and "
"benchmarking it. The result is a static estimate, not a measurement from the "
"GPU."
msgstr ""

#: ../../../tools/analyzer.md:8
msgid "Requirements"
msgstr ""

#: ../../../tools/analyzer.md:10
msgid ""
"The analyzer and its NumPy dependency are included in the standard TileLang "
"installation. No optional package is required."
msgstr ""

#: ../../../tools/analyzer.md:13
msgid ""
"The device model passed to the analyzer supplies architecture and bandwidth "
"information. For example, constructing `CUDA(\"cuda\")` queries CUDA device "
"0, so that workflow requires a working CUDA runtime and a visible GPU even "
"though the analyzer does not execute the kernel."
msgstr ""

#: ../../../tools/analyzer.md:18
msgid "Quick Start"
msgstr ""

#: ../../../tools/analyzer.md:20
msgid ""
"Create specialized TIR with `get_tir()`, then analyze the resulting "
"`PrimFunc`:"
msgstr ""

#: ../../../tools/analyzer.md:22
msgid ""
"import tilelang\n"
"import tilelang.language as T\n"
"from tilelang.carver.arch import CUDA\n"
"from tilelang.tools import Analyzer\n"
"\n"
"M = N = K = 1024\n"
"\n"
"\n"
"@tilelang.jit\n"
"def matmul(A, B, block_M, block_N, block_K):\n"
"    A: T.Tensor((M, K), T.float16)\n"
"    B: T.Tensor((N, K), T.float16)\n"
"    C = T.empty((M, N), T.float16)\n"
"\n"
"    with T.Kernel(\n"
"        T.ceildiv(N, block_N),\n"
"        T.ceildiv(M, block_M),\n"
"        threads=128,\n"
"    ) as (bx, by):\n"
"        A_shared = T.alloc_shared((block_M, block_K), T.float16)\n"
"        B_shared = T.alloc_shared((block_N, block_K), T.float16)\n"
"        C_local = T.alloc_fragment((block_M, block_N), T.float32)\n"
"\n"
"        T.clear(C_local)\n"
"        for k in T.serial(T.ceildiv(K, block_K)):\n"
"            T.copy(A[by * block_M, k * block_K], A_shared)\n"
"            T.copy(B[bx * block_N, k * block_K], B_shared)\n"
"            T.gemm(A_shared, B_shared, C_local, transpose_B=True)\n"
"        T.copy(C_local, C[by * block_M, bx * block_N])\n"
"\n"
"    return C\n"
"\n"
"\n"
"tir = matmul.get_tir(block_M=128, block_N=128, block_K=32)\n"
"device = CUDA(\"cuda\")\n"
"result = Analyzer.analysis(tir, device)\n"
"\n"
"print(f\"FLOPs: {result.total_flops}\")\n"
"print(f\"Global bytes: {result.total_global_bytes}\")\n"
"print(f\"Estimated seconds: {result.estimated_time}\")\n"
"print(f\"Model peak TFLOPS: {result.expected_tflops}\")\n"
"print(f\"Model bandwidth (GB/s): {result.expected_bandwidth_GBps}\")\n"
msgstr ""

#: ../../../tools/analyzer.md:67
msgid ""
"For this tiled GEMM, `total_flops` should equal `2 * M * N * K`. Memory "
"traffic is derived from the `T.copy` regions that cross the global-buffer "
"boundary."
msgstr ""

