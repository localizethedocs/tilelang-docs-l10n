msgstr ""

#: ../../../tools/analyzer.md:0
msgid "`total_flops`"
msgstr ""

#: ../../../tools/analyzer.md:0
msgid "FLOPs attributed to recognized `T.gemm` calls."
msgstr ""

#: ../../../tools/analyzer.md:0
msgid "`total_global_bytes`"
msgstr ""

#: ../../../tools/analyzer.md:0
