#: ../../../tools/iket.md:243
msgid ""
"iket_pid_0x....pftrace\n"
"iket_pid_0x....pftrace.gz\n"
"iket_pid_0x....trace.json\n"
"iket_pid_0x....html\n"
msgstr ""

#: ../../../tools/iket.md:250
msgid "TileLang can construct the same shell command from Python:"
