"command = iket.profile_command(\n"
"    [\"python\", \"examples/iket/all_features.py\", \"--iket-runtime-"
"payloads\"],\n"
"    directory=\"/tmp/tilelang_iket_all_features_profile\",\n"
")\n"
"print(command)\n"
msgstr ""

#: ../../../tools/iket.md:260
