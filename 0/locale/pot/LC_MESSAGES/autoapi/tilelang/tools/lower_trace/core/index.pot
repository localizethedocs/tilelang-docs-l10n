#: ../../../autoapi/tilelang/tools/lower_trace/core/index.rst:2
msgid "tilelang.tools.lower_trace.core"
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/core/index.rst:8
msgid ""
"IR lower trace — zero-intrusion debug tool for visualizing compilation "
"passes."
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/core/index.rst:10
msgid ""
"Monkey-patches ``tvm.ir.transform.Pass.__call__`` and ``PassPipeline.lower`` "
"to automatically capture IR before/after every pass and generate diff "
"reports."
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/core/index.rst:13
msgid ""
"This module reads its configuration (``TL_LOWER_TRACE`` / "
"``TL_LOWER_TRACE_DIR``) through the centralized ``tilelang.env`` "
"environment, or via values passed programmatically to ``enable()``."
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/core/index.rst:17
msgid ""
"Supports two architectures: - New: ``PassPipeline.lower`` (each backend "
"registers a pipeline object) - Old: phase-based functions called from "
"``tilelang.engine.lower``"
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/core/index.rst:21
msgid "Usage::"
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/core/index.rst:23
msgid ""
"TL_LOWER_TRACE=1 python my_kernel.py        # HTML report\n"
"TL_LOWER_TRACE=terminal python my_kernel.py  # terminal diff only\n"
"TL_LOWER_TRACE=both python my_kernel.py      # both terminal and HTML"
msgstr ""

