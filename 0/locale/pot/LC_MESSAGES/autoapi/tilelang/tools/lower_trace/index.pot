#: ../../../autoapi/tilelang/tools/lower_trace/index.rst:2
msgid "tilelang.tools.lower_trace"
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/index.rst:8
msgid ""
"IR Lower Trace — zero-intrusion debug tool for visualizing compilation "
"passes."
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/index.rst:10
msgid ""
"Generates a self-contained HTML page and/or terminal diff showing all passes "
"in the compilation pipeline with side-by-side IR diff for each pass."
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/index.rst:13
msgid "Usage::"
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/index.rst:15
msgid ""
"TL_LOWER_TRACE=1 python my_kernel.py        # HTML report\n"
"TL_LOWER_TRACE=terminal python my_kernel.py  # terminal diff only\n"
"TL_LOWER_TRACE=both python my_kernel.py      # both terminal and HTML"
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/index.rst:19
msgid "Programmatic API::"
msgstr ""

#: ../../../autoapi/tilelang/tools/lower_trace/index.rst:21
msgid ""
"from tilelang.tools.lower_trace import lower_trace\n"
"\n"
"lower_trace(func, my_pass, mode=\"terminal\")\n"
"lower_trace(func, [pass_a, pass_b], mode=\"both\", html_path=\"diff.html\")"
msgstr ""

