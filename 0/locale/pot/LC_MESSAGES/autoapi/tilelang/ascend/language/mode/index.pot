#: ../../../autoapi/tilelang/ascend/language/mode/index.rst:30
msgid ""
"``direction`` is ``\"m\"`` or ``\"n\"``. The setting applies to subsequent "
"GEMMs on the AIC, including block-scaled GEMMs. It changes the traversal "
"within a MAD, independently of the kernel's outer tile-loop order."
msgstr ""

#: ../../../autoapi/tilelang/ascend/language/mode/index.rst:0
msgid "Parameters"
msgstr ""

#: ../../../autoapi/tilelang/ascend/language/mode/index.rst:39
msgid ""
"Controls whether fp32 inputs to the Cube unit are truncated to HF32 (19-bit "
"mantissa) before multiplication, trading precision for throughput (~2x).  "
"Ignored for non-fp32 input types."
msgstr ""

#: ../../../autoapi/tilelang/ascend/language/mode/index.rst:43
msgid "Generates: AscendC::SetHF32Mode(HF32Mode::DISABLE/ENABLE) and"
msgstr ""

#: ../../../autoapi/tilelang/ascend/language/mode/index.rst:44
msgid "AscendC::SetHF32TransMode(HF32TransMode::NEAREST_ZERO/NEAREST_EVEN)."
msgstr ""

#: ../../../autoapi/tilelang/ascend/language/mode/index.rst:46
msgid ""
"- None (default): disable HF32, full fp32 precision. - \"nearest_zero\": "
"enable HF32, round toward zero. - \"nearest_even\": enable HF32, round to "
"nearest even."
msgstr ""

#: ../../../autoapi/tilelang/ascend/language/mode/index.rst:47
msgid "None (default): disable HF32, full fp32 precision."
msgstr ""

#: ../../../autoapi/tilelang/ascend/language/mode/index.rst:48
msgid "\"nearest_zero\": enable HF32, round toward zero."
msgstr ""

#: ../../../autoapi/tilelang/ascend/language/mode/index.rst:49
msgid "\"nearest_even\": enable HF32, round to nearest even."
msgstr ""

