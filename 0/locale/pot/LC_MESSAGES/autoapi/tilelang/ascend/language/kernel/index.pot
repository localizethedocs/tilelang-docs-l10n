#: ../../../autoapi/tilelang/ascend/language/kernel/index.rst:113
msgid ""
"with T.Kernel(NUM_CORES) as bx:\n"
"    with T.SimtVF(threads=128):\n"
"        for i in T.Parallel(128):\n"
"            out[bx * 128 + i] = x[bx * 128 + i] * 2.0"
msgstr ""

