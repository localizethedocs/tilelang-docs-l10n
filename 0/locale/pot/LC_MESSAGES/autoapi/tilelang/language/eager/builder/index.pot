msgid ""
"In eager mode, use T.const() to declare shape dimensions that will be "
"inferred from actual tensor arguments at runtime."
msgstr ""

#: ../../../autoapi/tilelang/language/eager/builder/index.rst:588
#: ../../../autoapi/tilelang/language/eager/builder/index.rst:604
#: ../../../autoapi/tilelang/language/eager/builder/index.rst:620
